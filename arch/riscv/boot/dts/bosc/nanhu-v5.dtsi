			intc_cpu9: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};
		};

		cpu10: cpu@10 {
			compatible = "bosc,nanhu-v5", "riscv";
			device_type = "cpu";
			mmu-type = "riscv,sv48";
			reg = <0xa>;
			riscv,isa = "rv64imafdc";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
