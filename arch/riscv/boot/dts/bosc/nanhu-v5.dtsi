			device_type = "cpu";
			mmu-type = "riscv,sv48";
			reg = <0x6>;
			riscv,isa = "rv64imafdc";
			riscv,isa-base = "rv64i";
			riscv,isa-extensions = "i", "m", "a", "f", "d", "c",
                                              "sstc";

                        status = "disabled";

			intc_cpu6: interrupt-controller {
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};
		};

