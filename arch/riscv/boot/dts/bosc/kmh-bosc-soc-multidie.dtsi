/* Common multidie blocks shared by kmh-bosc-soc DTS files. */

#define KMH_ISA "rv64imafdcbvh_zic64b_zicbom_zicbop_zicboz_ziccamoa_ziccif_zicclsm_ziccrse_zicond_zicntr_zicsr_zifencei_zihintntl_zihintpause_zihpm_zimop_za64rs_zacas_zawrs_zfa_zfh_zfhmin_zca_zcb_zcmop_zba_zbb_zbc_zbkb_zbkc_zbkx_zbs_zkn_zknd_zkne_zknh_zks_zksed_zksh_zkt_zvbb_zve32f_zve32x_zve64f_zve64d_zve64x_zvfh_zvfhmin_zvkb_zvkt_sdtrig_shcounterenw_sha_shgatpa_shtvala_shvsatpa_shvstvala_shvstvecd_smaia_smcsrind_smmpm_smnpm_smstateen_ssaia_ssccptr_sscofpmf_sscounterenw_sscsrind_ssdbltrp_ssnpm_sspm_ssstateen_ssstrict_sstc_sstvala_sstvecd_ssu64xl_supm_svade_svinval_svnapot_svpbmt"
#define KMH_ISA_EXT "i\0m\0a\0f\0d\0c\0b\0v\0h\0zic64b\0zicbom\0zicbop\0zicboz\0ziccamoa\0ziccif\0zicclsm\0ziccrse\0zicond\0zicntr\0zicsr\0zifencei\0zihintntl\0zihintpause\0zihpm\0zimop\0za64rs\0zacas\0zawrs\0zfa\0zfh\0zfhmin\0zca\0zcb\0zcmop\0zba\0zbb\0zbc\0zbkb\0zbkc\0zbkx\0zbs\0zkn\0zknd\0zkne\0zknh\0zks\0zksed\0zksh\0zkt\0zvbb\0zve32f\0zve32x\0zve64f\0zve64d\0zve64x\0zvfh\0zvfhmin\0zvkb\0zvkt\0sdtrig\0shcounterenw\0sha\0shgatpa\0shtvala\0shvsatpa\0shvstvala\0shvstvecd\0smaia\0smcsrind\0smmpm\0smnpm\0smstateen\0ssaia\0ssccptr\0sscofpmf\0sscounterenw\0sscsrind\0ssdbltrp\0ssnpm\0sspm\0ssstateen\0ssstrict\0sstc\0sstvala\0sstvecd\0ssu64xl\0supm\0svade\0svinval\0svnapot\0svpbmt"
#define KMH_NUMA0 numa-node-id = <0>;
#define KMH_NUMA1 numa-node-id = <1>;
#define KMH_NUMA2 numa-node-id = <2>;
#define KMH_NUMA3 numa-node-id = <3>;
#define KMH_NO_NUMA
#define KMH_CPU_BODY(_idx, _cpu_ph, _intc_ph, _status, _numa) \
    compatible = "riscv"; \
    device_type = "cpu"; \
    reg = <_idx>; \
    status = _status; \
    _numa \
    mmu-type = "riscv,sv48"; \
    riscv,isa-base = "rv64i"; \
    riscv,isa = KMH_ISA; \
    riscv,isa-extensions = KMH_ISA_EXT; \
    phandle = <_cpu_ph>; \
    cpu_intc##_idx: interrupt-controller { \
        compatible = "riscv,cpu-intc"; \
        interrupt-controller; \
        #interrupt-cells = <0x1>; \
        phandle = <_intc_ph>; \
    };
/ {
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    compatible = "bosc,kmh-bosc-soc";
    model = "BOSC KMH multi-die SoC";

    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        timebase-frequency = <100000000>;

        /* Enabled harts */
        cpu0: cpu@0 {
            KMH_CPU_BODY(0, 0x8080, 0x8081, "disabled", KMH_NUMA0)
        };

        cpu1: cpu@1 {
            KMH_CPU_BODY(1, 0x807e, 0x807f, "disabled", KMH_NUMA0)
        };

        cpu2: cpu@2 {
            KMH_CPU_BODY(2, 0x807c, 0x807d, "disabled", KMH_NUMA0)
        };

        cpu3: cpu@3 {
            KMH_CPU_BODY(3, 0x807a, 0x807b, "disabled", KMH_NUMA0)
        };

        cpu4: cpu@4 {
            KMH_CPU_BODY(4, 0x8078, 0x8079, "disabled", KMH_NUMA0)
        };

        cpu5: cpu@5 {
            KMH_CPU_BODY(5, 0x8076, 0x8077, "disabled", KMH_NUMA0)
        };

        cpu6: cpu@6 {
