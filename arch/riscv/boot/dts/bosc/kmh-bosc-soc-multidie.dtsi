        };

        cpu18: cpu@18 {
            KMH_CPU_BODY(18, 0x805c, 0x805d, "disabled", KMH_NUMA1)
        };

        cpu19: cpu@19 {
            KMH_CPU_BODY(19, 0x805a, 0x805b, "disabled", KMH_NUMA1)
        };

        cpu20: cpu@20 {
            KMH_CPU_BODY(20, 0x8058, 0x8059, "disabled", KMH_NUMA1)
        };

        cpu21: cpu@21 {
            KMH_CPU_BODY(21, 0x8056, 0x8057, "disabled", KMH_NUMA1)
        };

        cpu22: cpu@22 {
            KMH_CPU_BODY(22, 0x8054, 0x8055, "disabled", KMH_NUMA1)
        };

        cpu23: cpu@23 {
            KMH_CPU_BODY(23, 0x8052, 0x8053, "disabled", KMH_NUMA1)
        };

        cpu24: cpu@24 {
            KMH_CPU_BODY(24, 0x8050, 0x8051, "disabled", KMH_NUMA1)
        };

        cpu25: cpu@25 {
            KMH_CPU_BODY(25, 0x804e, 0x804f, "disabled", KMH_NUMA1)
        };

        cpu26: cpu@26 {
            KMH_CPU_BODY(26, 0x804c, 0x804d, "disabled", KMH_NUMA1)
        };

        cpu27: cpu@27 {
            KMH_CPU_BODY(27, 0x804a, 0x804b, "disabled", KMH_NUMA1)
        };

        cpu28: cpu@28 {
            KMH_CPU_BODY(28, 0x8048, 0x8049, "disabled", KMH_NUMA1)
        };

        cpu29: cpu@29 {
            KMH_CPU_BODY(29, 0x8046, 0x8047, "disabled", KMH_NUMA1)
        };

        cpu30: cpu@30 {
            KMH_CPU_BODY(30, 0x8044, 0x8045, "disabled", KMH_NUMA1)
        };

        cpu31: cpu@31 {
            KMH_CPU_BODY(31, 0x8042, 0x8043, "disabled", KMH_NUMA1)
        };

        cpu32: cpu@32 {
            KMH_CPU_BODY(32, 0x8040, 0x8041, "disabled", KMH_NUMA2)
        };

        cpu33: cpu@33 {
            KMH_CPU_BODY(33, 0x803e, 0x803f, "disabled", KMH_NUMA2)
        };

        cpu34: cpu@34 {
            KMH_CPU_BODY(34, 0x803c, 0x803d, "disabled", KMH_NUMA2)
        };

        cpu35: cpu@35 {
            KMH_CPU_BODY(35, 0x803a, 0x803b, "disabled", KMH_NUMA2)
        };

        cpu36: cpu@36 {
            KMH_CPU_BODY(36, 0x8038, 0x8039, "disabled", KMH_NUMA2)
        };

        cpu37: cpu@37 {
            KMH_CPU_BODY(37, 0x8036, 0x8037, "disabled", KMH_NUMA2)
        };

        cpu38: cpu@38 {
            KMH_CPU_BODY(38, 0x8034, 0x8035, "disabled", KMH_NUMA2)
        };

        cpu39: cpu@39 {
            KMH_CPU_BODY(39, 0x8032, 0x8033, "disabled", KMH_NUMA2)
        };

        cpu40: cpu@40 {
            KMH_CPU_BODY(40, 0x8030, 0x8031, "disabled", KMH_NUMA2)
        };

        cpu41: cpu@41 {
            KMH_CPU_BODY(41, 0x802e, 0x802f, "disabled", KMH_NUMA2)
        };

        cpu42: cpu@42 {
            KMH_CPU_BODY(42, 0x802c, 0x802d, "disabled", KMH_NUMA2)
        };

        cpu43: cpu@43 {
            KMH_CPU_BODY(43, 0x802a, 0x802b, "disabled", KMH_NUMA2)
        };

        cpu44: cpu@44 {
            KMH_CPU_BODY(44, 0x8028, 0x8029, "disabled", KMH_NUMA2)
        };

        cpu45: cpu@45 {
            KMH_CPU_BODY(45, 0x8026, 0x8027, "disabled", KMH_NUMA2)
        };

        cpu46: cpu@46 {
            KMH_CPU_BODY(46, 0x8024, 0x8025, "disabled", KMH_NUMA2)
        };

        cpu47: cpu@47 {
            KMH_CPU_BODY(47, 0x8022, 0x8023, "disabled", KMH_NUMA2)
        };

        cpu48: cpu@48 {
            KMH_CPU_BODY(48, 0x8020, 0x8021, "disabled", KMH_NUMA3)
        };

        cpu49: cpu@49 {
            KMH_CPU_BODY(49, 0x801e, 0x801f, "disabled", KMH_NUMA3)
        };

        cpu50: cpu@50 {
            KMH_CPU_BODY(50, 0x801c, 0x801d, "disabled", KMH_NUMA3)
