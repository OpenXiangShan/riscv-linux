        cpu52: cpu@52 {
            KMH_CPU_BODY(52, 0x8018, 0x8019, "disabled", KMH_NUMA3)
        };

        cpu53: cpu@53 {
            KMH_CPU_BODY(53, 0x8016, 0x8017, "disabled", KMH_NUMA3)
        };

        cpu54: cpu@54 {
            KMH_CPU_BODY(54, 0x8014, 0x8015, "disabled", KMH_NUMA3)
        };

        cpu55: cpu@55 {
            KMH_CPU_BODY(55, 0x8012, 0x8013, "disabled", KMH_NUMA3)
        };

        cpu56: cpu@56 {
            KMH_CPU_BODY(56, 0x8010, 0x8011, "disabled", KMH_NUMA3)
        };

        cpu57: cpu@57 {
            KMH_CPU_BODY(57, 0x800e, 0x800f, "disabled", KMH_NUMA3)
        };

        cpu58: cpu@58 {
            KMH_CPU_BODY(58, 0x800c, 0x800d, "disabled", KMH_NUMA3)
        };

        cpu59: cpu@59 {
            KMH_CPU_BODY(59, 0x800a, 0x800b, "disabled", KMH_NUMA3)
        };

        cpu60: cpu@60 {
            KMH_CPU_BODY(60, 0x8008, 0x8009, "disabled", KMH_NUMA3)
        };

        cpu61: cpu@61 {
            KMH_CPU_BODY(61, 0x8006, 0x8007, "disabled", KMH_NUMA3)
        };

        cpu62: cpu@62 {
            KMH_CPU_BODY(62, 0x8004, 0x8005, "disabled", KMH_NUMA3)
        };

        cpu63: cpu@63 {
            KMH_CPU_BODY(63, 0x8002, 0x8003, "disabled", KMH_NUMA3)
        };

    };

    soc: soc {
        compatible = "bosc,kmh-bosc-soc", "simple-bus";
        ranges;
        #address-cells = <0x2>;
        #size-cells = <0x2>;

        /* Global MSI and timer infrastructure */
        imsics_m: imsics-m {
            compatible = "riscv,imsics";
            interrupt-controller;
            msi-controller;
            #interrupt-cells = <0x0>;
            riscv,num-ids = <0xff>;
            riscv,group-index-bits = <0x2>;
            riscv,group-index-shift = <0x2c>;
            riscv,hart-index-bits = <0x4>;
            reg = <0x0 0x1c000000 0x0 0x10000>;
            interrupts-extended =
                <&cpu_intc0 0x0b>, <&cpu_intc1 0x0b>, <&cpu_intc2 0x0b>, <&cpu_intc3 0x0b>,
                <&cpu_intc4 0x0b>, <&cpu_intc5 0x0b>, <&cpu_intc6 0x0b>, <&cpu_intc7 0x0b>,
                <&cpu_intc8 0x0b>, <&cpu_intc9 0x0b>, <&cpu_intc10 0x0b>, <&cpu_intc11 0x0b>,
                <&cpu_intc12 0x0b>, <&cpu_intc13 0x0b>, <&cpu_intc14 0x0b>, <&cpu_intc15 0x0b>;
            phandle = <0x8000>;
        };

        imsics_s: imsics-s {
            compatible = "riscv,imsics";
            interrupt-controller;
            msi-controller;
            #interrupt-cells = <0x0>;
            riscv,num-ids = <0xff>;
            riscv,guest-index-bits = <0x4>;
            riscv,group-index-bits = <0x2>;
            riscv,group-index-shift = <0x2c>;
            riscv,hart-index-bits = <0x4>;
            reg = <0x0 0x1d000000 0x0 0x80000>;
            interrupts-extended = 
                <&cpu_intc0 0x09>, <&cpu_intc1 0x09>, <&cpu_intc2 0x09>, <&cpu_intc3 0x09>,
                <&cpu_intc4 0x09>, <&cpu_intc5 0x09>, <&cpu_intc6 0x09>, <&cpu_intc7 0x09>,
                <&cpu_intc8 0x09>, <&cpu_intc9 0x09>, <&cpu_intc10 0x09>, <&cpu_intc11 0x09>,
                <&cpu_intc12 0x09>, <&cpu_intc13 0x09>, <&cpu_intc14 0x09>, <&cpu_intc15 0x09>;
            phandle = <0x8001>;
        };

        mtimer: mtimer@19004000 {
            compatible = "riscv,aclint-mtimer";
            reg = <0x0 0x1900bff8 0x0 0x8 0x0 0x19004000 0x0 0x7ff8>;
            interrupts-extended =
                <&cpu_intc0 0x07>, <&cpu_intc1 0x07>, <&cpu_intc2 0x07>, <&cpu_intc3 0x07>,
                <&cpu_intc4 0x07>, <&cpu_intc5 0x07>, <&cpu_intc6 0x07>, <&cpu_intc7 0x07>,
                <&cpu_intc8 0x07>, <&cpu_intc9 0x07>, <&cpu_intc10 0x07>, <&cpu_intc11 0x07>,
                <&cpu_intc12 0x07>, <&cpu_intc13 0x07>, <&cpu_intc14 0x07>, <&cpu_intc15 0x07>;
        };

        mswi: mswi@19000000 {
            compatible = "riscv,aclint-mswi";
            interrupt-controller;
            #interrupt-cells = <0x0>;
            reg = <0x0 0x19000000 0x0 0x4000>;
            interrupts-extended =
                <&cpu_intc0 0x03>, <&cpu_intc1 0x03>, <&cpu_intc2 0x03>, <&cpu_intc3 0x03>,
                <&cpu_intc4 0x03>, <&cpu_intc5 0x03>, <&cpu_intc6 0x03>, <&cpu_intc7 0x03>,
                <&cpu_intc8 0x03>, <&cpu_intc9 0x03>, <&cpu_intc10 0x03>, <&cpu_intc11 0x03>,
                <&cpu_intc12 0x03>, <&cpu_intc13 0x03>, <&cpu_intc14 0x03>, <&cpu_intc15 0x03>;
        };

        aplic_m_die0: aplic-m@1e020000 {
            compatible = "riscv,aplic";
            interrupt-controller;
            #address-cells = <0x0>;
            #interrupt-cells = <0x2>;
            riscv,num-sources = <0x60>;
            riscv,children = <&aplic_s_die0>;
            riscv,delegate = <&aplic_s_die0 0x1 0x60>;
            riscv,delegation = <&aplic_s_die0 0x1 0x60>;
            reg = <0x0 0x1e020000 0x0 0x4000>;
            msi-parent = <&imsics_m>;
            phandle = <0x8082>;
        };

        aplic_s_die0: aplic-s@1e024000 {
            compatible = "riscv,aplic";
            interrupt-controller;
            #address-cells = <0x0>;
            #interrupt-cells = <0x2>;
            riscv,num-sources = <0x60>;
            reg = <0x0 0x1e024000 0x0 0x4000>;
            msi-parent = <&imsics_s>;
            phandle = <0x8083>;
        };

        uart0: serial@4000000 {
			interrupts = <0x0a 0x04>;
			interrupt-parent = <0x8082>;
            clock-frequency = <11000000>;
            current-speed = <115200>;
			reg-shift = <0x02>;
			reg = <0x00 0x4000000 0x00 0x10000>;
			compatible = "ns16550a";
		};
        dma-controller@b000000 {
			status = "okay";
			interrupts = <0x28 0x04>;
			interrupt-parent = <0x8082>;
			reg = <0x00 0xb000000 0x00 0x1000>;
			snps,data-width = <0x08>;
			snps,dma-masters = <0x01>;
			dma-channels = <0x02>;
			#dma-cells = <0x01>;
			dma-controller;
			compatible = "snps,axi-dma-1.01a";
		};
/*
        iommu0: iommu@4f80200000 {
            compatible = "riscv,iommu";
            status = "okay";
            #iommu-cells = <0x1>;
            reg = <0x4f 0x80200000 0x0 0x100000>;
            interrupt-parent = <&aplic_s_die0>;
            interrupts = <0x24 0x1 0x25 0x1 0x26 0x1 0x27 0x1>;
            msi-parent = <&imsics_s>;
        };*/

        /* PCIe root complexes */
        pci0: pci@4f00000000 {
            compatible = "snps,dw-pcie";
            device_type = "pci";
            status = "disabled";
            linux,pci-domain = <0x00>;
            bus-range = <0x00 0xff>;
            num-lanes = <0x01>;
            max-link-speed = <2>;
            //snps,atu-unroll = <0>;
            //dma-coherent;
            #address-cells = <0x3>;
            #size-cells = <0x2>;
            #interrupt-cells = <0x1>;
            interrupt-parent = <&aplic_s_die0>;
            msi-parent = <&imsics_s>;
            interrupt-names = "msi", "hp";
            interrupts = <0x0d 0x04 0x12 0x04>;
            interrupt-map-mask = <0x1800 0x00 0x00 0x07>;
            interrupt-map = <
                0x00 0x00 0x00 0x01 &aplic_s_die0 0x0e 0x04
                0x00 0x00 0x00 0x02 &aplic_s_die0 0x0f 0x04
                0x00 0x00 0x00 0x03 &aplic_s_die0 0x10 0x04
                0x00 0x00 0x00 0x04 &aplic_s_die0 0x11 0x04
                0x800 0x00 0x00 0x01 &aplic_s_die0 0x0f 0x04
                0x800 0x00 0x00 0x02 &aplic_s_die0 0x10 0x04
                0x800 0x00 0x00 0x03 &aplic_s_die0 0x11 0x04
                0x800 0x00 0x00 0x04 &aplic_s_die0 0x0e 0x04
                0x1000 0x00 0x00 0x01 &aplic_s_die0 0x10 0x04
                0x1000 0x00 0x00 0x02 &aplic_s_die0 0x11 0x04
                0x1000 0x00 0x00 0x03 &aplic_s_die0 0x0e 0x04
                0x1000 0x00 0x00 0x04 &aplic_s_die0 0x0f 0x04
                0x1800 0x00 0x00 0x01 &aplic_s_die0 0x11 0x04
                0x1800 0x00 0x00 0x02 &aplic_s_die0 0x0e 0x04
                0x1800 0x00 0x00 0x03 &aplic_s_die0 0x0f 0x04
                0x1800 0x00 0x00 0x04 &aplic_s_die0 0x10 0x04
            >;
            reg-names = "dbi", "config";
            
            reg = <0x04f 0x00000000 0x0 0x00400000 
                   0x048 0x00000000 0x0 0x10000000>;
            ranges = <
                0x02000000 0x00 0x50000000 0x480 0x00000000 0x00 0x20000000
                0x43000000 0x01 0x00000000 0x480 0x20000000 0x00 0x20000000
            >;
            dma-ranges = <0x02000000 0x0 0x80000000 0x0 0x80000000 0x0 0x80000000>;
        };

        pci@4f00800000 {
            compatible = "snps,dw-pcie";
            device_type = "pci";
            status = "disabled";
            linux,pci-domain = <0x01>;
            bus-range = <0x00 0xff>;
            num-lanes = <0x01>;
            #address-cells = <0x3>;
            #size-cells = <0x2>;
            #interrupt-cells = <0x1>;
            interrupt-parent = <&aplic_s_die0>;
            msi-parent = <&imsics_s>;
            interrupt-names = "msi", "hp";
            interrupts = <0x13 0x04 0x18 0x04>;
            interrupt-map-mask = <0x1800 0x00 0x00 0x07>;
            interrupt-map = <
                0x00 0x00 0x00 0x01 &aplic_s_die0 0x14 0x04
                0x00 0x00 0x00 0x02 &aplic_s_die0 0x15 0x04
                0x00 0x00 0x00 0x03 &aplic_s_die0 0x16 0x04
                0x00 0x00 0x00 0x04 &aplic_s_die0 0x17 0x04
                0x800 0x00 0x00 0x01 &aplic_s_die0 0x15 0x04
                0x800 0x00 0x00 0x02 &aplic_s_die0 0x16 0x04
                0x800 0x00 0x00 0x03 &aplic_s_die0 0x17 0x04
                0x800 0x00 0x00 0x04 &aplic_s_die0 0x14 0x04
                0x1000 0x00 0x00 0x01 &aplic_s_die0 0x16 0x04
                0x1000 0x00 0x00 0x02 &aplic_s_die0 0x17 0x04
                0x1000 0x00 0x00 0x03 &aplic_s_die0 0x14 0x04
                0x1000 0x00 0x00 0x04 &aplic_s_die0 0x15 0x04
                0x1800 0x00 0x00 0x01 &aplic_s_die0 0x17 0x04
                0x1800 0x00 0x00 0x02 &aplic_s_die0 0x14 0x04
                0x1800 0x00 0x00 0x03 &aplic_s_die0 0x15 0x04
                0x1800 0x00 0x00 0x04 &aplic_s_die0 0x16 0x04
            >;
            reg-names = "dbi", "config";
            reg = <0x4f 0x800000 0x00 0x400000 0x4f 0xc00000 0x00 0x10000>;
            ranges = <
                0x2000000 0x00 0x00 0x49 0x00 0x01 0x00
                0x3000000 0x01 0x00 0x4e0 0x00 0x10 0x00
            >;
        };

        pci@4f01000000 {
            compatible = "snps,dw-pcie";
            device_type = "pci";
            status = "disabled";
            linux,pci-domain = <0x02>;
            bus-range = <0x00 0xff>;
            num-lanes = <0x01>;
            #address-cells = <0x3>;
            #size-cells = <0x2>;
            #interrupt-cells = <0x1>;
            interrupt-parent = <&aplic_s_die0>;
            msi-parent = <&imsics_s>;
            interrupt-names = "msi", "hp";
            interrupts = <0x19 0x04 0x1e 0x04>;
            interrupt-map-mask = <0x1800 0x00 0x00 0x07>;
            interrupt-map = <
                0x00 0x00 0x00 0x01 &aplic_s_die0 0x1a 0x04
                0x00 0x00 0x00 0x02 &aplic_s_die0 0x1b 0x04
                0x00 0x00 0x00 0x03 &aplic_s_die0 0x1c 0x04
                0x00 0x00 0x00 0x04 &aplic_s_die0 0x1d 0x04
                0x800 0x00 0x00 0x01 &aplic_s_die0 0x1b 0x04
                0x800 0x00 0x00 0x02 &aplic_s_die0 0x1c 0x04
                0x800 0x00 0x00 0x03 &aplic_s_die0 0x1d 0x04
                0x800 0x00 0x00 0x04 &aplic_s_die0 0x1a 0x04
                0x1000 0x00 0x00 0x01 &aplic_s_die0 0x1c 0x04
                0x1000 0x00 0x00 0x02 &aplic_s_die0 0x1d 0x04
                0x1000 0x00 0x00 0x03 &aplic_s_die0 0x1a 0x04
                0x1000 0x00 0x00 0x04 &aplic_s_die0 0x1b 0x04
                0x1800 0x00 0x00 0x01 &aplic_s_die0 0x1d 0x04
                0x1800 0x00 0x00 0x02 &aplic_s_die0 0x1a 0x04
                0x1800 0x00 0x00 0x03 &aplic_s_die0 0x1b 0x04
                0x1800 0x00 0x00 0x04 &aplic_s_die0 0x1c 0x04
            >;
            reg-names = "dbi", "config";
            reg = <0x4f 0x1000000 0x00 0x400000 0x4f 0x1400000 0x00 0x10000>;
            ranges = <
                0x2000000 0x00 0x00 0x4a 0x00 0x01 0x00
                0x3000000 0x01 0x00 0x4f0 0x00 0x10 0x00
            >;
        };

    };


    aliases {
        serial0 = &uart0;
    };


    chosen {
        //stdout-path = "/soc/serial@4000000";
        bootargs = "console=hvc0 earlycon=sbi loglevel=8 drm.debug=0x2 amdgpu.cik=1 amdgpu.si=1 amdgpu.dpm=0 pcie_aspm=off pcie_port_pm=off amdgpu.vm_update_mode=3 root=/dev/sda rootwait rw";
        opensbi-config {
            compatible = "opensbi,config";
            cold-boot-harts = <&cpu0>;
        };
    };

};
