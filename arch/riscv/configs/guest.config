# Minimal guest fragment layered directly on top of defconfig.
# Usage:
#   make ARCH=riscv defconfig guest.config
#
# Goal:
# - boot guest from /dev/vda
# - use the repo-default initramfs.cpio
# - build overlay root in initramfs
# - access host data through virtio-fs only

CONFIG_INITRAMFS_SOURCE="initramfs.cpio"

# Trim unrelated platform support and optional subsystems inherited from defconfig.
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_VIRT is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_ACPI is not set

# The initramfs mounts overlayfs before switch_root, so overlayfs must be
# built-in instead of a module.
CONFIG_OVERLAY_FS=y

CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# Guest path only needs virtio-fs, not 9p or host-side networking.
# CONFIG_NET is not set
# Strip the 9p fallback path; this guest should validate virtio-fs directly.
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_NET_9P is not set
# CONFIG_NET_9P_VIRTIO is not set
# CONFIG_9P_FS is not set
# CONFIG_9P_FS_POSIX_ACL is not set

# Keep serial + virtio block/fs, drop unrelated peripherals.
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_MTD is not set
# CONFIG_MMC is not set
# CONFIG_INPUT is not set
# CONFIG_I2C is not set
# CONFIG_SPI is not set
# CONFIG_PINCTRL is not set
# CONFIG_DMADEVICES is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_POWER_RESET is not set
# CONFIG_WATCHDOG is not set
# CONFIG_REGULATOR is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_COMMON_CLK is not set
# CONFIG_SIFIVE_PLIC is not set
# CONFIG_RESET_CONTROLLER is not set
